#!/usr/bin/env bash
#
# The whole pipeline, one C++ or C file to one executable:
#
#   clang++ -fclangir -emit-cir        C++ -> CIR, with the shim's annotations
#   (clang for a C file)
#   wtc-link                           several files' CIR modules -> one
#   wtc-opt                            lift, analyse ownership and borrowing,
#                                      specialise, lower
#   cir-translate --cir-to-llvmir      CIR -> LLVM IR
#   clang++                            LLVM IR -> executable
#
#   wtc-cc [options] file.cpp -o prog
#   wtc-cc [options] file.c -o prog
#   wtc-cc [options] a.c b.c ... -o prog
#
# With --lift, a C file's own queues, a ring of pointers under a pthread
# mutex (--wtc-lift-c-queues, docs/lifting.md "C queues"), are replaced by
# the runtime of shim/c_queue.h, which this script then compiles and links.
#
# Options of its own (everything else goes to both clang invocations):
#   --keep DIR         keep the intermediate .cir/.ll files in DIR
#   --no-specialize    run the analysis but leave every tag alone (the
#                      "generic" build of an unmodified source)
#   --lift             lift the program's own locked queues
#                      (--wtc-lift-locked-queues, --wtc-lift-c-queues,
#                      docs/lifting.md): a class the pass lifts is replaced
#                      by wtc::lifted, whose instantiations this script adds,
#                      and a C struct by shim/c_queue.h's runtime. A class or
#                      struct lifts only in a whole program: not with -c, and
#                      not when a file linked here names it or its code may
#                      reach the object, which an escape analysis decides.
#                      Off by default until that analysis has been reviewed
#                      (docs/lifting.md, "Opt-in")
#   --no-lift          leave those queues as written (the default)
#   --unity            accepted and ignored: several source files of one
#                      language are always compiled apart, each to its CIR
#                      module, and linked into one module (tools: wtc-link),
#                      so that the analysis sees the whole program while each
#                      file means what it means alone (its statics its own,
#                      its macros and pragmas its own); until 6 Nov 2026 they
#                      were concatenated into one translation unit
#   --force-spsc SYMS  tag these global queues spsc regardless of the verdict
#                      (negative control; pass a comma-separated list)
#   --force-inline SYMS  tag these global queues spsc_inline regardless of
#                      the verdicts (negative control, as above)
#   --batch-cost MODE  estimate (default): hold a mutex across a WTC_BATCH
#                      loop's critical sections only where the work between
#                      them is estimated under the threshold (decisions/0006);
#                      off: wherever it is legal
#   --batch-host NAME  the class of host the program will run on, whose
#                      constant and thresholds that estimate takes
#                      (decisions/0006 lists them); without it the default
#                      class, sapphire-rapids, is applied whatever the host
#   --batch-ns-per-unit NS  nanoseconds a unit of that estimate takes on the
#                      host, in place of the class's (decisions/0006)
#   --toolchain DIR    where clang++, wtc-opt, cir-translate live (default:
#                      wtc-opt from the build tree next to this repo, the
#                      rest from PATH)
#   --tsan             build the compiler's own output under ThreadSanitizer
#   -c                 stop at an object file, for a program whose other files
#                      are built without wtc-cc and linked with it; the
#                      analysis then lets those files name any external
#                      symbol of this one (open-world), and object files,
#                      archives and shared objects linked here the symbols
#                      nm lists for them (named-elsewhere); a C struct's
#                      queue then does not lift, other units seeing it
#   --wtc-opt-arg ARG  pass ARG to wtc-opt (repeatable), e.g. --mlir-timing
#   --census           call wtc_rc_note at the entry of shared_ptr's reference
#                      counts (--wtc-census), for the thread census in
#                      tools/census; the symbol is weak and left for the
#                      loader, so the program runs with that library
#                      preloaded (or defines wtc_rc_note itself)
#
# Object files, archives and -l/-L/-Wl, arguments go to the final link only.
# With WTC_CC_TIMES=FILE in the environment, each step's wall time is
# appended to FILE as "step seconds" lines (cir, wtc-opt, cir-translate,
# backend), which is what the compile-cost measurement reads.
#
# --tsan exists because the pinned clang has the instrumentation but no
# sanitizer runtime: it instruments the object, and a compiler that has the
# runtime links it ($WTC_TSAN_CXX, else clang++-18, else clang++). The
# runtime comes from another LLVM release; its entry points have not changed
# in years, and test/Integration/tsan_own_build_caught.cpp would notice if
# they did. Every function is marked sanitize_thread, which clang's front
# end does for source and does not do for an .ll file: without the mark,
# only atomics are instrumented and a run is silent whatever it does.
#
# The data-layout line cir-translate prints does not match the target's
# string byte for byte and clang refuses the module; it is dropped and clang
# supplies the target default, which is the same layout spelled its own way.
# A reference to a function, passed as an argument (g3log hands one to a
# std::function constructor), is lowered as dereferenceable(0), which the
# IR verifier rejects; the attribute promises nothing at zero bytes and is
# dropped.
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)

SRCS=()
KEEP=""; SPECIALIZE=1; LIFT=0; TSAN=0; CENSUS=0; COMPILE_ONLY=0; FORCE=""; FORCE_INLINE=""; TOOLCHAIN=""; OUT="a.out"; SRC=""
BATCH_COST=""; BATCH_HOST=""; BATCH_NS=""
PASSTHRU=(); LINKARGS=(); OPTARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --keep) KEEP=$2; shift 2 ;;
    --no-specialize) SPECIALIZE=0; shift ;;
    --lift) LIFT=1; shift ;;
    --no-lift) LIFT=0; shift ;;
    --unity) shift ;;
    --force-spsc) FORCE=$2; shift 2 ;;
    --force-inline) FORCE_INLINE=$2; shift 2 ;;
    --toolchain) TOOLCHAIN=$2; shift 2 ;;
    --batch-cost) BATCH_COST=$2; shift 2 ;;
    --batch-host) BATCH_HOST=$2; shift 2 ;;
    --batch-ns-per-unit) BATCH_NS=$2; shift 2 ;;
    --tsan) TSAN=1; shift ;;
    --census) CENSUS=1; shift ;;
    -c) COMPILE_ONLY=1; shift ;;
    --wtc-opt-arg) OPTARGS+=("$2"); shift 2 ;;
    -o) OUT=$2; shift 2 ;;
    *.cpp|*.cc|*.cxx|*.c) SRCS+=("$1"); shift ;;
    *.o|*.a|*.so|-l*|-L*|-Wl,*) LINKARGS+=("$1"); shift ;;
    *) PASSTHRU+=("$1"); shift ;;
  esac
done
[ ${#SRCS[@]} -gt 0 ] || { echo "wtc-cc: no source file" >&2; exit 2; }
SRC=${SRCS[0]}
LANG_C=0
case "$SRC" in *.c) LANG_C=1 ;; esac
for s in "${SRCS[@]}"; do
  case "$s" in *.c) c=1 ;; *) c=0 ;; esac
  (( c == LANG_C )) || { echo "wtc-cc: the source files must be of one language, C or C++" >&2; exit 2; }
done

find_tool() { # name, candidates...
  local name=$1; shift
  for c in "$@"; do [ -x "$c" ] && { echo "$c"; return; }; done
  command -v "$name" || { echo "wtc-cc: cannot find $name" >&2; exit 2; }
}
# clang++ and cir-translate come from the LLVM toolchain; wtc-opt from this
# repository's build tree. WTC_OPT in the environment overrides the latter,
# which is how the lit tests point at the build they are testing.
if [ -n "$TOOLCHAIN" ]; then
  CLANGXX="$TOOLCHAIN/bin/clang++"; CLANGC="$TOOLCHAIN/bin/clang"; CIRTR="$TOOLCHAIN/bin/cir-translate"
else
  CLANGXX=$(find_tool clang++ "$ROOT/build-llvm/bin/clang++" /opt/llvm/bin/clang++)
  CLANGC=$(find_tool clang "$ROOT/build-llvm/bin/clang" /opt/llvm/bin/clang)
  CIRTR=$(find_tool cir-translate "$ROOT/build-llvm/bin/cir-translate" /opt/llvm/bin/cir-translate)
fi
WTCOPT=${WTC_OPT:-$(find_tool wtc-opt "$ROOT/build/bin/wtc-opt")}
# wtc-link lives next to wtc-opt.
WTCLINK=${WTC_LINK:-$(dirname "$WTCOPT")/wtc-link}

WORK=${KEEP:-$(mktemp -d)}
mkdir -p "$WORK"
[ -n "$KEEP" ] || trap 'rm -rf "$WORK"' EXIT
base=$(basename "${SRC%.*}")
# Runs a step, and with WTC_CC_TIMES set records how long it took.
step() { # name, command...
  local name=$1; shift
  if [ -z "${WTC_CC_TIMES:-}" ]; then "$@"; return; fi
  local t0 t1
  t0=$(date +%s%N); "$@"; t1=$(date +%s%N)
  awk -v n="$name" -v a="$t0" -v b="$t1" 'BEGIN { printf "%s %.6f\n", n, (b - a) / 1e9 }' >> "$WTC_CC_TIMES"
}

# What the rest of the program may name. The analysis takes a file with
# main, linked with nothing but -l libraries, for the whole program
# (docs/audit.md). Compiled with -c, the file is linked later with others
# it never sees, which may name any of its external symbols. Linked here
# with object files, archives or shared objects, it shares with them the
# symbols they define or reference, which nm lists; without nm, any.
QOA=--queue-ownership-analysis
if (( COMPILE_ONLY )); then
  QOA=--queue-ownership-analysis=open-world=true
else
  OTHERS=()
  for a in "${LINKARGS[@]}"; do case "$a" in *.o|*.a|*.so) OTHERS+=("$a") ;; esac; done
  if (( ${#OTHERS[@]} )); then
    NM=""
    for c in ${TOOLCHAIN:+"$TOOLCHAIN/bin/llvm-nm"} "$ROOT/build-llvm/bin/llvm-nm" \
             "$(command -v llvm-nm || true)" "$(command -v nm || true)"; do
      if [ -n "$c" ] && [ -x "$c" ]; then NM=$c; break; fi
    done
    listed=1
    : > "$WORK/$base.nm"
    for o in "${OTHERS[@]}"; do
      flags=(-P -g); [[ $o == *.so ]] && flags+=(-D)
      [ -n "$NM" ] && "$NM" "${flags[@]}" "$o" >> "$WORK/$base.nm" 2>/dev/null || listed=0
    done
    if (( listed )); then
      # posix format: "name type [value size]", and "archive[member]:"
      # before each member of an archive.
      awk 'NF >= 2 && $1 !~ /:$/ { print $1 }' "$WORK/$base.nm" | sort -u > "$WORK/$base.elsewhere"
      # The symbols they define, apart from those they only reference: a
      # function of a library's name defined there is the program's.
      awk 'NF >= 2 && $1 !~ /:$/ && $2 != "U" && $2 != "w" && $2 != "v" { print $1 }' "$WORK/$base.nm" |
        sort -u > "$WORK/$base.defined"
      QOA="--queue-ownership-analysis=named-elsewhere=$WORK/$base.elsewhere"
    else
      echo "wtc-cc: cannot list the symbols of ${OTHERS[*]}; any symbol of $SRC may be named there" >&2
      QOA=--queue-ownership-analysis=open-world=true
    fi
  fi
fi
# The lifting of the program's own queues, C++ or C, sees what the analysis
# sees: a class or struct other files may use as written does not lift.
LIFTOPTS=""
case "$QOA" in
  *open-world*) LIFTOPTS="open-world=true" ;;
  *named-elsewhere=*) LIFTOPTS="named-elsewhere=${QOA#*named-elsewhere=} defined-elsewhere=$WORK/$base.defined" ;;
esac

# Each source file to its CIR module; several are linked into one
# (wtc-link): a file's statics stay its own (renamed where another file
# has the name), one definition of each external symbol is kept, as the
# linker keeps one, and each file is compiled apart, with only its own
# macros, pragmas and declarations, so that it means what it means alone.
# EXTRA[i] is appended to file i (the runtime's instantiations, below).
UNITS=(); EXTRA=()
for s in "${SRCS[@]}"; do UNITS+=("$(cd "$(dirname "$s")" && pwd)/$(basename "$s")"); EXTRA+=(""); done
emit_cir() {
  local i src out
  CIRS=()
  for i in "${!UNITS[@]}"; do
    src=${UNITS[$i]}
    if [ -n "${EXTRA[$i]}" ]; then
      src="$WORK/$base.$i.lifted.cpp"
      # The runtime's header first, so that no macro of the program's
      # reaches it; the instantiations after the file, which defines the
      # container's type.
      { printf '#include "lifted.hpp"\n#include "%s"\n' "${UNITS[$i]}"; printf '%s' "${EXTRA[$i]}"; } > "$src"
    fi
    out="$WORK/$base.$i.cir"
    (( ${#UNITS[@]} == 1 )) && out="$WORK/$base.cir"
    if (( LANG_C )); then
      step cir "$CLANGC" -fclangir -emit-cir "${PASSTHRU[@]}" "$src" -o "$out"
    else
      step cir "$CLANGXX" -std=c++17 -I"$ROOT/shim" -fclangir -emit-cir "${PASSTHRU[@]}" "$src" -o "$out"
    fi
    CIRS+=("$out")
  done
  if (( ${#UNITS[@]} > 1 )); then
    [ -x "$WTCLINK" ] || { echo "wtc-cc: cannot find wtc-link next to $WTCOPT" >&2; exit 2; }
    step link "$WTCLINK" "${CIRS[@]}" -o "$WORK/$base.cir"
  fi
}
emit_cir

# The program's own locked queues. The runtime that replaces them is a
# template the program never names, so a first look lists the container
# types of the classes that would lift, and the files are compiled again
# with their explicit instantiations after them: the program's text is
# unchanged, and the second CIR is the first plus wtc::lifted<C> for each.
# An instantiation goes after the first file in which it compiles (the one
# that defines the container's type). The pass itself runs in the pipeline
# below.
PRE=()
if (( LIFT && LANG_C )); then
  PRE=("--wtc-lift-c-queues${LIFTOPTS:+=$LIFTOPTS}")
elif (( LIFT )); then
  step lift-scan "$WTCOPT" "$WORK/$base.cir" "--wtc-lift-locked-queues=rewrite=false instantiations=$WORK/$base.inst${LIFTOPTS:+ $LIFTOPTS}" \
    -o /dev/null 2>/dev/null
  if [ -s "$WORK/$base.inst" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      placed=0
      for i in "${!UNITS[@]}"; do
        if (( ${#UNITS[@]} == 1 )) ||
           { printf '#include "lifted.hpp"\n#include "%s"\n%s\n' "${UNITS[$i]}" "$line" |
             "$CLANGXX" -std=c++17 -I"$ROOT/shim" -I"$(dirname "${UNITS[$i]}")" "${PASSTHRU[@]}" -fsyntax-only -w -x c++ - \
               >/dev/null 2>&1; }; then
          EXTRA[$i]+="$line"$'\n'; placed=1; break
        fi
      done
      (( placed )) || { echo "wtc-cc: no source file can instantiate: $line" >&2; exit 2; }
    done < "$WORK/$base.inst"
    emit_cir
  fi
  PRE=("--wtc-lift-locked-queues${LIFTOPTS:+=$LIFTOPTS}")
fi

LOCKOPTS=""
[ -n "$BATCH_COST" ] && LOCKOPTS="cost=$BATCH_COST"
[ -n "$BATCH_HOST" ] && LOCKOPTS="${LOCKOPTS:+$LOCKOPTS }host=$BATCH_HOST"
[ -n "$BATCH_NS" ] && LOCKOPTS="${LOCKOPTS:+$LOCKOPTS }ns-per-unit=$BATCH_NS"
PASSES=("${PRE[@]}" --lift-cir-to-wtc --wtc-batch-pushes "--wtc-batch-locks${LOCKOPTS:+=$LOCKOPTS}"
        "$QOA")
PASSES+=(--wtc-borrow-analysis)
if (( SPECIALIZE )); then
  OPTS=""
  [ -n "$FORCE" ] && OPTS="force-spsc=$FORCE"
  [ -n "$FORCE_INLINE" ] && OPTS="${OPTS:+$OPTS }force-inline=$FORCE_INLINE"
  PASSES+=("--wtc-specialize${OPTS:+=$OPTS}")
else
  PASSES+=(--wtc-specialize=rewrite=false)
fi
PASSES+=(--wtc-check-progress --lower-wtc-to-cir)
if (( CENSUS )); then PASSES+=(--wtc-census); fi
PASSES+=(--reconcile-unrealized-casts)
# Diagnostics name their place; printing the whole operation after each one
# repeats a queue's type, hundreds of characters, on every line.
step wtc-opt "$WTCOPT" --mlir-print-op-on-diagnostic=false "${OPTARGS[@]}" "$WORK/$base.cir" "${PASSES[@]}" -o "$WORK/$base.wtc.cir"

step cir-translate "$CIRTR" --cir-to-llvmir "$WORK/$base.wtc.cir" -o "$WORK/$base.raw.ll"
sed -e '/^target datalayout/d' -e 's/ dereferenceable(0)//g' "$WORK/$base.raw.ll" > "$WORK/$base.ll"

# The flags for compiling the IR: the language's own (-std=) do not apply.
BACKFLAGS=()
for a in "${PASSTHRU[@]}"; do case "$a" in -std=*) ;; *) BACKFLAGS+=("$a") ;; esac; done
# A lifted C queue's runtime (shim/c_queue.cpp), built with the program's
# optimisation, debug and WTC_* flags. Never with -c: there other units
# may touch the struct, and nothing lifts.
RTOBJ=""
if grep -q '@wtc_c_queue_' "$WORK/$base.wtc.cir"; then
  RTFLAGS=()
  for a in "${PASSTHRU[@]}"; do case "$a" in -O*|-g*|-DWTC_*) RTFLAGS+=("$a") ;; esac; done
  (( TSAN )) && RTFLAGS+=(-fsanitize=thread)
  RTOBJ="$WORK/c_queue.o"
  step runtime "$CLANGXX" -std=c++17 "${RTFLAGS[@]}" -c "$ROOT/shim/c_queue.cpp" -o "$RTOBJ"
fi

if (( TSAN )); then
  LINKXX=${WTC_TSAN_CXX:-$(command -v clang++-18 || command -v clang++ || echo clang++)}
  "$CLANGXX" "${BACKFLAGS[@]}" -fsanitize=thread -mllvm -force-attribute=sanitize_thread \
    -c "$WORK/$base.ll" -o "$( (( COMPILE_ONLY )) && echo "$OUT" || echo "$WORK/$base.o")"
  (( COMPILE_ONLY )) || "$LINKXX" -fsanitize=thread "$WORK/$base.o" $RTOBJ "${LINKARGS[@]}" -o "$OUT" -pthread
elif (( COMPILE_ONLY )); then
  step backend "$CLANGXX" "${BACKFLAGS[@]}" -c "$WORK/$base.ll" -o "$OUT"
else
  step backend "$CLANGXX" "${BACKFLAGS[@]}" "$WORK/$base.ll" $RTOBJ "${LINKARGS[@]}" -o "$OUT" -pthread
fi
